=================================================================
3. WINDOW CREATION (CreateWindow)
=================================================================
Creates the main selector window that holds all panels.

SYNTAX:
    local Window = UILib:CreateWindow({
        Title = "My GUI",             -- Window title (string)
        AccentColor = Color3,         -- Optional: Accent color for styling
        Name = "MyWindow",            -- Optional: ScreenGui name
        Position = UDim2,             -- Optional: Starting position
        DisplayOrder = 10000          -- Optional: Display order
    })

RETURNS: Window object with these methods:
    - Window:ShowPanel(panelName)     -- Show a panel by name
    - Window:HidePanel(panelName)     -- Hide a panel by name
    - Window:CreatePanel(config)      -- Create a new panel
    - Window:AddToggleKey(keyCode)    -- Add keybind to toggle GUI visibility
    - Window:Notify(config)           -- Create notification (same as UILib:CreateNotification)
    - Window:Confirm(config)          -- Create confirmation dialog
    - Window:Destroy()                -- Destroy the window

WINDOW PROPERTIES:
    - Window.ScreenGui                -- The ScreenGui instance
    - Window.Panels                   -- Table of all panels (keyed by name)
    - Window.CurrentPanel             -- Name of currently shown panel
    - Window.AccentColor              -- The accent color
    - Window.SelectorFrame            -- The main selector frame

EXAMPLE:
    local Window = UILib:CreateWindow({
        Title = "Retro Breach",
        AccentColor = Color3.fromRGB(255, 100, 150)
    })

=================================================================
4. PANEL CREATION (CreatePanel)
=================================================================
Creates a tab/panel that can contain UI elements.

SYNTAX:
    local Panel = Window:CreatePanel({
        Name = "Combat",              -- Panel identifier (string)
        DisplayName = "Combat Tab",   -- Display name (optional, defaults to Name)
        Color = Color3,               -- Optional: Panel accent color
        LayoutOrder = 1,              -- Optional: Order in selector list
        Size = UDim2,                 -- Optional: Custom panel size
        HelpText = "Desc here..."     -- Optional: Help tutorial text for this panel
    })

RETURNS: Panel object with these properties/methods:
    - Panel.Name                      -- Panel identifier
    - Panel.Frame                     -- The panel Frame instance
    - Panel.ScrollingFrame            -- ScrollingFrame for content
    - Panel.Button                    -- Selector button
    - Panel.ContentY                  -- Current Y position for content
    - Panel:UpdateCanvasSize()        -- Update scrolling canvas size

EXAMPLE:
    local CombatPanel = Window:CreatePanel({
        Name = "Combat",
        DisplayName = "Combat",
        LayoutOrder = 1
    })
    
    local ESPPanel = Window:CreatePanel({
        Name = "ESP",
        DisplayName = "ESP / Visuals",
        LayoutOrder = 2
    })

=================================================================
5. TOGGLE (CreateToggle)
=================================================================
Creates a simple on/off toggle switch.

SYNTAX:
    local ToggleObj = UILib:CreateToggle(Panel, {
        Label = "Enable Feature",     -- Toggle label text
        Default = false,              -- Initial state (boolean)
        Callback = function(state)    -- Called when toggled
            -- state is boolean (true/false)
        end
    })

RETURNS: Toggle object with these methods:
    - ToggleObj.Toggle()              -- Toggle the switch
    - ToggleObj.GetState()            -- Returns current boolean state
    - ToggleObj.SetState(bool)        -- Set state (triggers callback)
    - ToggleObj.SetStateSilent(bool)  -- Set state without callback (for config loading)
    - ToggleObj.Track                 -- Track Frame reference
    - ToggleObj.Label                 -- Label TextLabel reference

IMPORTANT: SetStateSilent is used for loading saved configs without re-triggering side effects.

EXAMPLE:
    Toggles.Aimbot = UILib:CreateToggle(CombatPanel, {
        Label = "Aimbot",
        Default = Config.Aimbot,
        Callback = function(state)
            Config.Aimbot = state
        end
    })
    
    -- Later, to sync from config:
    Toggles.Aimbot.SetState(Config.Aimbot)

=================================================================
6. COLLAPSIBLE TOGGLE (CreateCollapsibleToggle)
=================================================================
Creates a toggle with expandable sub-toggles below it.
Clicking the arrow (▶) expands/collapses the sub-options.

SYNTAX:
    local CollapsibleObj = UILib:CreateCollapsibleToggle(Panel, {
        Label = "Main Toggle",
        Default = false,
        Callback = function(state) end,
        AutoCloseDelay = 1,           -- Delay before auto-closing other collapsibles
        SubToggles = {
            {
                Label = "Sub Option 1",
                Default = false,
                Callback = function(state) end
            },
            {
                Label = "Sub Option 2",
                Default = true,
                Callback = function(state) end
            }
        }
    })

RETURNS: Collapsible object with:
    - CollapsibleObj.Toggle()         -- Toggle main switch
    - CollapsibleObj.GetState()       -- Get main toggle state
    - CollapsibleObj.SetState(bool)   -- Set main toggle state
    - CollapsibleObj.IsExpanded()     -- Check if expanded
    - CollapsibleObj.Expand()         -- Expand sub-toggles
    - CollapsibleObj.Collapse()       -- Collapse sub-toggles
    - CollapsibleObj.SubToggles       -- Array of sub-toggle objects
        - CollapsibleObj.SubToggles[1].SetState(bool)

EXAMPLE:
    Toggles.RageBot = UILib:CreateCollapsibleToggle(CombatPanel, {
        Label = "Rage Bot",
        Default = Config.RageBot,
        Callback = function(state)
            Config.RageBot = state
        end,
        SubToggles = {
            {
                Label = "One Tap",
                Default = Config.RageBotOneTap,
                Callback = function(state)
                    Config.RageBotOneTap = state
                end
            },
            {
                Label = "Rapid Fire",
                Default = Config.RageBotRapidFire,
                Callback = function(state)
                    Config.RageBotRapidFire = state
                end
            }
        }
    })

=================================================================
7. SLIDER (CreateSlider)
=================================================================
Creates a draggable slider for numeric values.

SYNTAX:
    local SliderObj = UILib:CreateSlider(Panel, {
        Text = "Walk Speed",          -- Slider label
        Min = 0,                      -- Minimum value
        Max = 100,                    -- Maximum value
        Default = 16,                 -- Initial value
        Callback = function(value)    -- Called on value change
            -- value is number
        end
    })

RETURNS: Slider object with:
    - SliderObj.SetValue(number)      -- Set slider value programmatically

EXAMPLE:
    Sliders.AimbotFOV = UILib:CreateSlider(CombatPanel, {
        Text = "Aimbot FOV",
        Min = 50,
        Max = 800,
        Default = Config.AimbotFOV,
        Callback = function(value)
            Config.AimbotFOV = value
        end
    })

=================================================================
8. DROPDOWN (CreateDropdown)
=================================================================
Creates a dropdown selection menu with search functionality.

SYNTAX:
    local DropdownObj = UILib:CreateDropdown(Panel, {
        Label = "Target Priority",
        Options = {"Head", "Body", "Closest"},  -- Array of options
        EnableSearch = true,          -- Enable search box (default: true)
        Callback = function(selected)
            -- selected is the string option name
        end
    })

RETURNS: Dropdown object with:
    - DropdownObj.SetValue(string)     -- Set selected option
    - DropdownObj.GetValue()           -- Get selected option
    - DropdownObj.UpdateOptions(tbl)   -- Replace options array

EXAMPLE:
    Dropdowns.AimAssistTarget = UILib:CreateDropdown(CombatPanel, {
        Label = "Aim Assist Target",
        Options = {"Head Only", "Body Only", "Humanized"},
        Callback = function(selected)
            Config.AimAssistTarget = selected
        end
    })
    
    -- Set value programmatically:
    Dropdowns.AimAssistTarget.SetValue("Humanized")
    
    -- Update options dynamically:
    Dropdowns.AimAssistTarget.UpdateOptions({"Option A", "Option B", "Option C"})

=================================================================
9. BUTTON (CreateButton)
=================================================================
Creates a clickable button.

SYNTAX:
    local ButtonObj = UILib:CreateButton(Panel, {
        Text = "Apply Settings",
        Color = UILib.Colors.SUCCESS,  -- Optional: Button color
        Callback = function()
            -- Called on click
        end
    })

RETURNS: Button object with:
    - ButtonObj.Button                 -- TextButton reference
    - ButtonObj.SetText(string)        -- Change button text
    - ButtonObj.SetColor(Color3)       -- Change button color
    - ButtonObj.SetEnabled(bool)       -- Enable/disable button
    - ButtonObj.SetCallback(fn)        -- Change callback function

EXAMPLE:
    UILib:CreateButton(SettingsPanel, {
        Text = "Save Config",
        Color = UILib.Colors.SUCCESS,
        Callback = function()
            SaveConfigAs("default")
            UILib:CreateNotification({Text = "Config Saved!", Duration = 2})
        end
    })

=================================================================
10. TEXT INPUT (CreateTextInput)
=================================================================
Creates a text input box.

SYNTAX:
    local InputObj = UILib:CreateTextInput(Panel, {
        Placeholder = "Enter name...",  -- Placeholder text
        Default = "",                   -- Default value
        Callback = function(text, enterPressed)
            -- text: current text
            -- enterPressed: true if Enter was pressed
        end
    })

RETURNS: TextInput object with:
    - InputObj.TextBox                 -- TextBox reference
    - InputObj.GetText()               -- Get current text
    - InputObj.SetText(string)         -- Set text
    - InputObj.SetPlaceholder(string)  -- Change placeholder

EXAMPLE:
    TextInputs.SpoofedName = UILib:CreateTextInput(SettingsPanel, {
        Placeholder = "Spoofed display name...",
        Default = Config.SpoofedName,
        Callback = function(text, enterPressed)
            Config.SpoofedName = text
        end
    })

=================================================================
11. KEYBIND (CreateKeybind)
=================================================================
Creates a rebindable keybind control.

SYNTAX:
    local KeybindObj = UILib:CreateKeybind(Panel, {
        ActionName = "Toggle Fly",       -- Keybind identifier
        DefaultKey = Enum.KeyCode.V,     -- Default key
        Callback = function()            -- Called when key pressed
            -- Triggered by pressing the bound key
        end
    })

RETURNS: Keybind object with:
    - KeybindObj.SetKey(keyCode)       -- Set keybind programmatically
    - KeybindObj.GetKey()              -- Get current keybind
    - KeybindObj.Remove()              -- Remove keybind control

NOTES:
- Click the keybind to rebind
- Press ESC to unbind
- Keybinds are saved to "UILib_Keybinds.json" automatically

EXAMPLE:
    UILib:CreateKeybind(SettingsPanel, {
        ActionName = "Toggle Fly",
        DefaultKey = Enum.KeyCode.V,
        Callback = function()
            _G.RetroBreach.ToggleFly()
        end
    })

=================================================================
12. NOTIFICATION (CreateNotification)
=================================================================
Creates a temporary notification popup.

SYNTAX:
    UILib:CreateNotification({
        Text = "Feature enabled!",
        Duration = 3,                    -- Seconds to show (default: 3)
        Color = UILib.Colors.SUCCESS     -- Border color
    })

RETURNS: ScreenGui reference (auto-destroys after duration)

EXAMPLE:
    UILib:CreateNotification({
        Text = "Config loaded successfully!",
        Duration = 2,
        Color = UILib.Colors.SUCCESS
    })
    
    UILib:CreateNotification({
        Text = "Error: Player not found",
        Duration = 5,
        Color = UILib.Colors.ERROR
    })

=================================================================
13. LOADING SCREEN (CreateLoadingScreen)
=================================================================
Creates a loading screen with progress bar.

SYNTAX:
    local LoadingObj = UILib:CreateLoadingScreen({
        Title = "Retro Breach",
        AccentColor = Color3,            -- Loading bar color
        Duration = 2.5,                  -- Loading duration in seconds
        OnComplete = function()          -- Called when loading finished
            -- Setup code here
        end
    })

RETURNS: Loading object with:
    - LoadingObj.Gui                   -- ScreenGui reference
    - LoadingObj.Blur                  -- Blur effect reference
    - LoadingObj.Destroy()             -- Force destroy loading screen

EXAMPLE:
    UILib:CreateLoadingScreen({
        Title = "Retro Breach",
        AccentColor = Color3.fromRGB(255, 100, 150),
        Duration = 3,
        OnComplete = function()
            -- Initialize main GUI after loading
            local Window = UILib:CreateWindow({Title = "Retro Breach"})
        end
    })

