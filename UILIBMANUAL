18. SAVING/SYNCING UI STATE
=================================================================
When building a config system, register UI elements in tables for syncing:

REGISTRY PATTERN:
    local Toggles = {}      -- Store toggle references
    local Sliders = {}      -- Store slider references
    local Dropdowns = {}    -- Store dropdown references
    local TextInputs = {}   -- Store text input references

CREATING WITH REGISTRY:
    Toggles.Aimbot = UILib:CreateToggle(Panel, {
        Label = "Aimbot",
        Default = Config.Aimbot,
        Callback = function(state)
            Config.Aimbot = state
        end
    })
    
    Sliders.AimbotFOV = UILib:CreateSlider(Panel, {
        Text = "Aimbot FOV",
        Min = 50, Max = 800,
        Default = Config.AimbotFOV,
        Callback = function(value)
            Config.AimbotFOV = value
        end
    })

SYNCING FROM CONFIG (after loading saved config):
    local function SyncToggles()
        for key, toggle in pairs(Toggles) do
            if toggle and toggle.SetState and Config[key] ~= nil then
                pcall(function()
                    toggle.SetState(Config[key])
                end)
            end
        end
        
        for key, slider in pairs(Sliders) do
            if slider and slider.SetValue and Config[key] ~= nil then
                pcall(function()
                    slider.SetValue(Config[key])
                end)
            end
        end
        
        for key, dropdown in pairs(Dropdowns) do
            if dropdown and dropdown.SetValue and Config[key] ~= nil then
                pcall(function()
                    dropdown.SetValue(Config[key])
                end)
            end
        end
    end

