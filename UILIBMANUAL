20. UNIVERSAL ESP (UILib.ESP)
=================================================================
Performs Universal ESP for Players (Health/Role/Distance) and Items.
Includes built-in Highlights and BillboardGuis.

CONFIGURATION:
    UILib.ESP.Config = {
        Enabled = false,              -- Master switch (use Toggle())
        
        -- Player Settings
        PlayerESP = true,             -- Enable Player Visuals
        ShowName = true,              -- Show Player Name
        ShowRole = true,              -- Show Team/Role Name
        ShowHealth = true,            -- Show Health (Green/Orange/Red)
        ShowItems = false,            -- Show Equipped Item
        ShowDistance = false,         -- Show Distance from LocalPlayer
        UseTeamColors = true,         -- Use TeamColor for Highlights/Text
        
        -- Item Settings
        ItemESP = false,              -- Enable Item Visuals
        ItemDistance = 150,           -- Max distance for Items
        ShowItemName = true,          -- Show Item Name
        
        -- Colors
        EnemyColor = Color3.fromRGB(255, 0, 0),
        AllyColor = Color3.fromRGB(0, 255, 0),
        ItemColor = Color3.fromRGB(255, 255, 0)
    }

METHODS:
    - UILib.ESP:Toggle(bool)          -- Enable/Disable the entire system
    - UILib.ESP:Update()              -- Force a visual update (called automatically loop)

USAGE EXAMPLE:
    -- 1. Configure Settings
    UILib.ESP.Config.PlayerESP = true
    UILib.ESP.Config.ShowHealth = true
    
    -- 2. Hook up to UI Toggles
    Toggles.PlayerESP = UILib:CreateToggle(VisualsPanel, {
        Label = "Player ESP",
        Default = false,
        Callback = function(state)
            UILib.ESP.Config.PlayerESP = state
            UILib.ESP:Toggle(true) -- Ensure system is running
        end
    })
    
    -- 3. Start System
    UILib.ESP:Toggle(true)

